#!/usr/bin/env bash
# Serafort Python SDK - pre-commit hook
#
# Enable with:
#   git config core.hooksPath .githooks
#
# This is a plain POSIX shell script (works under Git Bash, macOS/Linux
# shells, and WSL). This package has no Node/npm toolchain, so Husky
# (an npm-based git hooks manager) does not apply here; `.githooks/` +
# `core.hooksPath` is the native git mechanism and needs nothing installed
# beyond git and Python tooling already required to develop the SDK.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

run() {
  echo "==> $*"
  "$@"
}

if command -v poetry >/dev/null 2>&1; then
  RUN=(poetry run)
else
  echo "poetry not found on PATH; falling back to the active Python environment." >&2
  RUN=()
fi

run "${RUN[@]}" ruff check .
run "${RUN[@]}" mypy serafort/
# Full suite runs fast (< 1s) today; switch to a marker-based subset
# (e.g. `-m "not slow"`) if the suite grows heavy enough to slow down commits.
run "${RUN[@]}" pytest -q

echo "pre-commit checks passed."
